# Cloudflare Pages Custom Headers
# TODO: CSP header is NOT included yet. It requires testing with the React build output
# to ensure inline scripts, styles, and eval() are properly handled. Add after build verification.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/og-image.svg
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400